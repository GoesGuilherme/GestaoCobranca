# Runtime da aplicação. No computador local, use a mesma URL de DIRECT_URL.
# No Supabase com serverless, este pode ser o pooler (modo sessão).
DATABASE_URL="postgresql://gestao:gestao@127.0.0.1:5432/gestaocobranca"

# Migrations (prisma migrate). No Supabase, use a conexão direta, porta 5432.
DIRECT_URL="postgresql://gestao:gestao@127.0.0.1:5432/gestaocobranca"

# Segredo do cookie de sessão. Troque por uma string longa e aleatória.
# Exemplo: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-por-outro-bem-longo"

# Acesso criado pelo seed. Em produção, defina uma senha forte
# e deixe SEED_EXEMPLOS=false para não gravar clientes fictícios.
SEED_OWNER_NOME="Marina Exemplo"
SEED_OWNER_EMAIL="marina@exemplo.test"
SEED_OWNER_SENHA="exemplo-1234"
SEED_EXEMPLOS="true"
