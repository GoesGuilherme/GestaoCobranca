# Runtime da aplicação.
# Local: a mesma URL de DIRECT_URL.
# Vercel + Supabase: pooler de transação, porta 6543, com ?pgbouncer=true.
# Exemplo:
# postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://gestao:gestao@127.0.0.1:5432/gestaocobranca"

# Prisma Migrate (prisma.config.ts). Não use a porta 6543.
# No Supabase: conexão direta (db.<ref>.supabase.co:5432) ou pooler em modo sessão (porta 5432).
DIRECT_URL="postgresql://gestao:gestao@127.0.0.1:5432/gestaocobranca"

# Segredo do cookie de sessão. Obrigatório na Vercel.
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-por-outro-bem-longo"

# Só o seed local (npm run db:seed). Não use em produção.
SEED_OWNER_NOME="Marina Exemplo"
SEED_OWNER_EMAIL="marina@exemplo.test"
SEED_OWNER_SENHA="exemplo-1234"
SEED_EXEMPLOS="true"

# E-mail da plataforma para redefinir senha. Não é a chave da Resend de cada empresa.
# AUTH_EMAIL_FROM padrão: Taguaro <noreply@taguaro.com.br>, no domínio taguaro.com.br.
# Sem AUTH_RESEND_API_KEY a tela avisa que não deu para enviar e o servidor registra
# o motivo. O link não entra no log.
AUTH_RESEND_API_KEY=""
AUTH_EMAIL_FROM="Taguaro <noreply@taguaro.com.br>"

# Protege as rotas diárias /api/cron/regua e /api/cron/visualizacoes.
# A Vercel Cron envia Authorization: Bearer com este valor.
# Gere com: openssl rand -base64 32
# Não é a chave da Resend. Cada empresa guarda a própria, cifrada.
CRON_SECRET=""

# Criptografia da chave de API e do token de webhook do Asaas, da chave da Resend
# e do auth token da subconta Twilio de cada empresa, em repouso.
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Não é a chave da API do Asaas nem o token da Twilio. Não troque a chave se já houver segredo gravado.
# Não use esta chave para o Banco Inter nem para configuracoes_pagamento.
ASAAS_ENCRYPTION_KEY=""

# Cifra client id, segredo, certificado e chave privada dos bancos novos
# (tabela configuracoes_pagamento). É outra chave, não a ASAAS_ENCRYPTION_KEY.
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Sem ela, a tela do Banco Inter não grava nem lê as credenciais.
PAGAMENTOS_ENCRYPTION_KEY=""

# Origem pública HTTPS usada para registrar o webhook do Inter.
# Exemplo: https://app.taguaro.com.br
# Sem ela, as credenciais são gravadas e a tela mostra o caminho do webhook,
# mas o Taguaro não chama o Inter para cadastrar a URL.
PAGAMENTOS_PUBLIC_URL=""

# Conta pai da Twilio. Não digite isso na tela. Cada empresa ganha uma subconta pela API.
# TWILIO_ACCOUNT_SID começa com AC. O auth token fica só aqui.
# TWILIO_WEBHOOK_URL é o endereço público exato de /api/webhooks/twilio (https em produção).
# TWILIO_WHATSAPP_TESTE é o único número que recebe mensagem com o modo teste ligado.
# TWILIO_MOCK=true só fora de produção; em produção a aplicação recusa. Fora de produção o padrão já é mock.
# Não defina TWILIO_MOCK na Vercel.
# Sandbox: enquanto não houver Sender ONLINE, TWILIO_WHATSAPP_SANDBOX=true
# (ou TWILIO_WHATSAPP_FROM=whatsapp:+14155238886) manda o modo teste pela conta pai,
# From whatsapp:+14155238886, só para TWILIO_WHATSAPP_TESTE. Fora do modo teste não envia.
# A régua usa o ContentSid da conta pai. O assessor usa texto livre dentro de 24h.
# Apague essas variáveis quando o Sender da empresa ficar ONLINE.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_URL=""
TWILIO_WHATSAPP_TESTE=""
TWILIO_MOCK=""
TWILIO_WHATSAPP_SANDBOX=""
TWILIO_WHATSAPP_FROM=""
TWILIO_CONTENT_SID_BOLETO_GERADO=""
TWILIO_CONTENT_SID_VENCE_EM_DIAS=""
TWILIO_CONTENT_SID_VENCEU=""
TWILIO_CONTENT_SID_PAGO=""
# SMS da régua, pela API Messages (Body), não pelo canal WhatsApp.
# Nasce desligado. true só tenta enviar, e mesmo assim apenas no modo teste,
# para TWILIO_SMS_TESTE ou, se ele estiver vazio, para TWILIO_WHATSAPP_TESTE.
# Fora do modo teste nada sai. Não defina TWILIO_SMS_ENABLED=true na Vercel neste momento.
# TWILIO_SMS_FROM só é aceito se for o número já comprado e Online como WhatsApp Sender.
# Outro número é ignorado. Este arquivo não consulta a Twilio: se +16504762069
# não puder enviar SMS, a fila registra a falha e não troca o remetente.
# SMS para o Brasil a partir de um número +1 pode ter entrega irregular.
TWILIO_SMS_ENABLED="false"
TWILIO_SMS_FROM="+16504762069"
TWILIO_SMS_TESTE=""

# Assessor de cobrança no WhatsApp. Fora de produção a IA fica no mock e não chama a rede.
# AI_GATEWAY_MODEL é um id provider/modelo do catálogo https://ai-gateway.vercel.sh/v1/models
# A chave não fica no código: AI_GATEWAY_API_KEY, ou o OIDC da Vercel (VERCEL_OIDC_TOKEN).
# Os tetos e o timeout podem ficar vazios: a aplicação usa o padrão.
AI_GATEWAY_MODEL=""
AI_GATEWAY_API_KEY=""
ASSESSOR_TETO_TOKENS=""
ASSESSOR_TETO_TOKENS_DIA=""
ASSESSOR_TIMEOUT_MS=""
ASSESSOR_LIMITE_TELEFONE=""
ASSESSOR_LIMITE_EMPRESA=""

# Só desenvolvimento, sem chave real. true responde o Asaas em memória e não chama a rede.
# É recusado quando NODE_ENV=production. Não defina na Vercel.
ASAAS_MOCK=""

# Primeiro acesso real. Rode uma vez, na sua máquina, com as URLs de produção:
# ADMIN_NOME="..." ADMIN_EMAIL="..." ADMIN_SENHA="..." npm run criar-admin
# Não coloque ADMIN_SENHA na Vercel.
ADMIN_NOME=""
ADMIN_EMAIL=""
ADMIN_SENHA=""
