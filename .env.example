# Runtime da aplicação.
# Local: a mesma URL de DIRECT_URL.
# Vercel + Supabase: pooler de transação, porta 6543, com ?pgbouncer=true.
# Exemplo:
# postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://gestao:gestao@127.0.0.1:5432/gestaocobranca"

# Prisma Migrate (prisma.config.ts). Não use a porta 6543.
# No Supabase: conexão direta (db.<ref>.supabase.co:5432) ou pooler em modo sessão (porta 5432).
DIRECT_URL="postgresql://gestao:gestao@127.0.0.1:5432/gestaocobranca"

# Segredo do cookie de sessão. Obrigatório na Vercel.
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-por-outro-bem-longo"

# Só o seed local (npm run db:seed). Não use em produção.
SEED_OWNER_NOME="Marina Exemplo"
SEED_OWNER_EMAIL="marina@exemplo.test"
SEED_OWNER_SENHA="exemplo-1234"
SEED_EXEMPLOS="true"

# Primeiro acesso real. Rode uma vez, na sua máquina, com as URLs de produção:
# ADMIN_NOME="..." ADMIN_EMAIL="..." ADMIN_SENHA="..." npm run criar-admin
# Não coloque ADMIN_SENHA na Vercel.
ADMIN_NOME=""
ADMIN_EMAIL=""
ADMIN_SENHA=""
