// Cadastro de clientes (grupos do PDVLegal), filiais e serviços vendidos.
// Servico é o catálogo da empresa assinante (o que ela vende aos clientes dela).
// ClienteServico guarda o valor combinado daquele cliente. O plano da Empresa
// (string `plano`) é a assinatura dela na plataforma e não se mistura com este catálogo.
// Módulos seguintes — boletos da Cora, chamados e a cobrança recorrente —
// entram como tabelas novas com chave para Cliente e, quando couber, ClienteServico.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 não aceita mais `url` nem `directUrl` neste bloco.
// As migrations usam DIRECT_URL em prisma.config.ts.
// A aplicação usa DATABASE_URL (no Supabase, pooler de transação na porta 6543,
// com ?pgbouncer=true). Ver src/server/db.ts.
datasource db {
  provider = "postgresql"
}

enum Segmento {
  RESTAURANTE
  MERCADO_AUTONOMO
  OUTRO

  @@map("segmento")
}

enum StatusCliente {
  ATIVO
  INATIVO
  EM_IMPLANTACAO

  @@map("status_cliente")
}

enum StatusFilial {
  ATIVA
  INATIVA
  EM_IMPLANTACAO

  @@map("status_filial")
}

enum TipoDocumento {
  CPF
  CNPJ

  @@map("tipo_documento")
}

enum StatusEmpresa {
  ATIVA
  SUSPENSA

  @@map("status_empresa")
}

enum PapelUsuario {
  DONO
  FINANCEIRO
  SUPORTE

  @@map("papel_usuario")
}

enum RecorrenciaServico {
  MENSAL
  AVULSO

  @@map("recorrencia_servico")
}

enum StatusServicoCliente {
  ATIVO
  INATIVO

  @@map("status_servico_cliente")
}

// A empresa é a assinante do SaaS. Clientes e usuários ficam dentro dela.
model Empresa {
  id               String           @id @default(cuid())
  razaoSocial      String           @map("razao_social")
  nomeFantasia     String           @map("nome_fantasia")
  cnpj             String           @unique
  emailContato     String           @map("email_contato")
  telefone         String
  status           StatusEmpresa    @default(ATIVA)
  plano            String           @default("basico")
  criadoEm         DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  usuarios         Usuario[]
  clientes         Cliente[]
  servicos         Servico[]
  servicosVendidos ClienteServico[]

  @@map("empresas")
}

// Contagem simples de tentativas de autocadastro, por IP e por e-mail.
model LimiteCadastro {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([chave, criadoEm])
  @@map("limites_cadastro")
}

model Usuario {
  id                 String       @id @default(cuid())
  nome               String
  email              String       @unique
  senhaHash          String       @map("senha_hash")
  empresaId          String       @map("empresa_id")
  papel              PapelUsuario @default(SUPORTE)
  superadministrador Boolean      @default(false)
  criadoEm           DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa            Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("usuarios")
}

model Cliente {
  id            String           @id @default(cuid())
  empresaId     String           @map("empresa_id")
  nomeFantasia  String           @map("nome_fantasia")
  razaoSocial   String           @map("razao_social")
  documento     String
  tipoDocumento TipoDocumento    @map("tipo_documento")
  segmento      Segmento
  contatoNome   String           @map("contato_nome")
  whatsapp      String
  email         String
  cidade        String
  uf            String
  status        StatusCliente
  observacoes   String?          @db.Text
  criadoEm      DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  filiais       Filial[]
  servicos      ClienteServico[]

  @@unique([empresaId, documento])
  @@index([empresaId])
  @@index([nomeFantasia])
  @@index([cidade])
  @@index([status])
  @@index([segmento])
  @@map("clientes")
}

model Filial {
  id           String       @id @default(cuid())
  clienteId    String       @map("cliente_id")
  nome         String
  cnpj         String
  endereco     String
  cidade       String
  uf           String
  status       StatusFilial
  observacoes  String?      @db.Text
  criadoEm     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // O CNPJ da filial não é único: no PDVLegal a filial é a unidade
  // operacional, e mais de uma pode compartilhar o mesmo CNPJ.
  @@index([clienteId])
  @@index([nome])
  @@map("filiais")
}

// Catálogo do que a empresa assinante vende. O preço padrão só sugere o valor
// no momento do vínculo; o combinado fica em ClienteServico.
// Custo e alíquota são opcionais e ficam só aqui: a margem da ficha do cliente
// recalcula com o custo atual e com o percentual sobre o valor combinado.
model Servico {
  id              String           @id @default(cuid())
  empresaId       String           @map("empresa_id")
  nome            String
  descricao       String?          @db.Text
  precoPadrao     Decimal          @map("preco_padrao") @db.Decimal(12, 2)
  custo           Decimal?         @db.Decimal(12, 2)
  aliquotaImposto Decimal?         @map("aliquota_imposto") @db.Decimal(5, 2)
  ativo           Boolean          @default(true)
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  vinculos        ClienteServico[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("servicos")
}

// Serviço vendido a um cliente, com o valor combinado. empresaId repete o da
// sessão para a consulta não depender só do join. Um gatilho na migration
// recusa cliente ou serviço de outra empresa.
model ClienteServico {
  id           String               @id @default(cuid())
  empresaId    String               @map("empresa_id")
  clienteId    String               @map("cliente_id")
  servicoId    String               @map("servico_id")
  valor        Decimal              @db.Decimal(12, 2)
  recorrencia  RecorrenciaServico
  inicioEm     DateTime             @map("inicio_em") @db.Date
  status       StatusServicoCliente @default(ATIVO)
  observacoes  String?              @db.Text
  criadoEm     DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa      Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente      Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico      Servico              @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@index([clienteId])
  @@index([servicoId])
  @@index([empresaId, status, recorrencia])
  @@map("clientes_servicos")
}
