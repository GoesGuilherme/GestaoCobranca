// Cadastro de clientes, filiais e serviços vendidos de cada empresa assinante.
// Servico é o catálogo da empresa (o que ela vende aos clientes dela).
// ClienteServico guarda o valor combinado daquele cliente. O plano da Empresa
// (string `plano`) é a assinatura dela na plataforma e não se mistura com este catálogo.
// A cobrança nova é do Asaas: configuração e preferências por empresa, cliente,
// fatura e assinatura mensal no vínculo MENSAL. A Cora não entra neste modelo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 não aceita mais `url` nem `directUrl` neste bloco.
// As migrations usam DIRECT_URL em prisma.config.ts.
// A aplicação usa DATABASE_URL (no Supabase, pooler de transação na porta 6543,
// com ?pgbouncer=true). Ver src/server/db.ts.
datasource db {
  provider = "postgresql"
}

enum Segmento {
  RESTAURANTE
  MERCADO_AUTONOMO
  OUTRO

  @@map("segmento")
}

enum StatusCliente {
  ATIVO
  INATIVO
  EM_IMPLANTACAO
  BLOQUEADO

  @@map("status_cliente")
}

enum StatusFilial {
  ATIVA
  INATIVA
  EM_IMPLANTACAO

  @@map("status_filial")
}

enum TipoDocumento {
  CPF
  CNPJ

  @@map("tipo_documento")
}

enum StatusEmpresa {
  ATIVA
  SUSPENSA

  @@map("status_empresa")
}

enum PapelUsuario {
  DONO
  FINANCEIRO
  SUPORTE

  @@map("papel_usuario")
}

enum RecorrenciaServico {
  MENSAL
  AVULSO

  @@map("recorrencia_servico")
}

enum StatusServicoCliente {
  ATIVO
  INATIVO

  @@map("status_servico_cliente")
}

enum AmbienteAsaas {
  SANDBOX
  PRODUCAO

  @@map("ambiente_asaas")
}

// A empresa é a assinante do SaaS. Clientes e usuários ficam dentro dela.
model Empresa {
  id               String           @id @default(cuid())
  razaoSocial      String           @map("razao_social")
  nomeFantasia     String           @map("nome_fantasia")
  cnpj             String           @unique
  emailContato     String           @map("email_contato")
  telefone         String
  status           StatusEmpresa    @default(ATIVA)
  plano            String           @default("basico")
  criadoEm         DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  usuarios         Usuario[]
  clientes         Cliente[]
  servicos         Servico[]
  servicosVendidos ClienteServico[]
  asaas            ConfiguracaoAsaas?
  preferenciaCobranca PreferenciaCobranca?
  faturas          Fatura[]
  eventosAsaas     EventoAsaas[]
  configuracaoRegua ConfiguracaoRegua?
  reguasCobranca   ReguaCobranca[]
  passosRegua      PassoRegua[]
  lembretesRegua   LembreteRegua[]

  @@map("empresas")
}

// Contagem simples de tentativas de autocadastro, por IP e por e-mail.
model LimiteCadastro {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([chave, criadoEm])
  @@map("limites_cadastro")
}

model Usuario {
  id                 String       @id @default(cuid())
  nome               String
  email              String       @unique
  senhaHash          String       @map("senha_hash")
  empresaId          String       @map("empresa_id")
  papel              PapelUsuario @default(SUPORTE)
  superadministrador Boolean      @default(false)
  versaoSessao       Int          @default(0) @map("versao_sessao")
  criadoEm           DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa            Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  redefinicoesSenha  RedefinicaoSenha[]

  @@index([empresaId])
  @@map("usuarios")
}

// Link de redefinição de senha. Só o hash do token fica gravado.
model RedefinicaoSenha {
  id        String    @id @default(cuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz(3)
  usadoEm   DateTime? @map("usado_em") @db.Timestamptz(3)
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("redefinicoes_senha")
}

model Cliente {
  id            String           @id @default(cuid())
  empresaId     String           @map("empresa_id")
  nomeFantasia  String           @map("nome_fantasia")
  razaoSocial   String           @map("razao_social")
  documento     String
  tipoDocumento TipoDocumento    @map("tipo_documento")
  segmento      Segmento
  contatoNome   String           @map("contato_nome")
  whatsapp      String
  email         String
  cidade        String
  uf            String
  status          StatusCliente
  ativadoEm       DateTime?        @map("ativado_em") @db.Date
  observacoes     String?          @db.Text
  asaasCustomerId String?          @map("asaas_customer_id")
  reguaId         String?          @map("regua_id")
  reguaModo       String           @default("PADRAO") @map("regua_modo")
  reguaPausada    Boolean          @default(false) @map("regua_pausada")
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  regua           ReguaCobranca?   @relation(fields: [reguaId], references: [id], onDelete: Restrict)
  filiais         Filial[]
  servicos        ClienteServico[]
  faturas         Fatura[]
  lembretesRegua  LembreteRegua[]

  @@index([asaasCustomerId])
  @@index([reguaId])

  @@unique([empresaId, documento])
  @@index([empresaId])
  @@index([nomeFantasia])
  @@index([cidade])
  @@index([status])
  @@index([segmento])
  @@map("clientes")
}

model Filial {
  id           String       @id @default(cuid())
  clienteId    String       @map("cliente_id")
  nome         String
  cnpj         String
  endereco     String
  cidade       String
  uf           String
  status       StatusFilial
  observacoes  String?      @db.Text
  criadoEm     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // O CNPJ da filial não é único: a filial é a unidade operacional,
  // e mais de uma pode compartilhar o mesmo CNPJ.
  @@index([clienteId])
  @@index([nome])
  @@map("filiais")
}

// Catálogo do que a empresa assinante vende. O preço padrão e o custo padrão
// só sugerem os valores no momento do vínculo. A alíquota fica aqui e incide
// sobre o valor combinado de cada venda.
model Servico {
  id              String           @id @default(cuid())
  empresaId       String           @map("empresa_id")
  nome            String
  descricao       String?          @db.Text
  precoPadrao     Decimal          @map("preco_padrao") @db.Decimal(12, 2)
  custo           Decimal?         @db.Decimal(12, 2)
  aliquotaImposto Decimal?         @map("aliquota_imposto") @db.Decimal(5, 2)
  ativo           Boolean          @default(true)
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  vinculos        ClienteServico[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("servicos")
}

// Serviço vendido a um cliente. valor e custo são deste vínculo: mudar o
// catálogo depois não reescreve a linha. empresaId repete o da sessão para a
// consulta não depender só do join. Um gatilho na migration recusa cliente
// ou serviço de outra empresa.
model ClienteServico {
  id           String               @id @default(cuid())
  empresaId    String               @map("empresa_id")
  clienteId    String               @map("cliente_id")
  servicoId    String               @map("servico_id")
  valor        Decimal              @db.Decimal(12, 2)
  custo        Decimal?             @db.Decimal(12, 2)
  recorrencia  RecorrenciaServico
  inicioEm     DateTime             @map("inicio_em") @db.Date
  status       StatusServicoCliente @default(ATIVO)
  observacoes              String?              @db.Text
  asaasSubscriptionId      String?              @unique @map("asaas_subscription_id")
  asaasAssinaturaStatus    String?              @map("asaas_assinatura_status")
  formaCobrancaRecorrente  String?              @map("forma_cobranca_recorrente")
  diaVencimento            Int?                 @map("dia_vencimento")
  proximoVencimento        DateTime?            @map("proximo_vencimento") @db.Date
  descricaoRecorrente      String?              @map("descricao_recorrente") @db.Text
  urlCobranca              String?              @map("url_cobranca") @db.Text
  cartaoStatus             String?              @map("cartao_status")
  cartaoBandeira           String?              @map("cartao_bandeira")
  cartaoFinal              String?              @map("cartao_final")
  criadoEm                 DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm             DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa                  Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente                  Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico                  Servico              @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  faturas                  Fatura[]

  @@index([empresaId])
  @@index([clienteId])
  @@index([servicoId])
  @@index([empresaId, status, recorrencia])
  @@map("clientes_servicos")
}

// Padrões de cobrança de uma empresa. Não exige chave do Asaas: a tela
// preenche os formulários com estes valores e cada venda ainda pode trocar.
model PreferenciaCobranca {
  id                 String   @id @default(cuid())
  empresaId          String   @unique @map("empresa_id")
  formaCobranca      String   @default("BOLETO") @map("forma_cobranca")
  diaVencimento      Int      @default(10) @map("dia_vencimento")
  modeloDescricao    String   @default("Mensalidade {servico}") @map("modelo_descricao") @db.Text
  multaPercentual    Decimal? @map("multa_percentual") @db.Decimal(5, 2)
  jurosPercentual    Decimal? @map("juros_percentual") @db.Decimal(5, 2)
  descontoPercentual Decimal? @map("desconto_percentual") @db.Decimal(5, 2)
  descontoDiasAntes  Int?     @map("desconto_dias_antes")
  diasAntesGerar     Int?     @map("dias_antes_gerar")
  atualizarPendentes Boolean  @default(false) @map("atualizar_pendentes")
  modeloMensagem     String   @default("Olá, {cliente}. Segue a cobrança de {servico}, no valor de {valor}, com vencimento em {vencimento}: {link}") @map("modelo_mensagem") @db.Text
  modeloAssunto      String   @default("Cobrança de {cliente}") @map("modelo_assunto")
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("preferencias_cobranca")
}

// Uma configuração por empresa. A chave da API e o token do webhook ficam
// cifrados com ASAAS_ENCRYPTION_KEY. O hash do token serve para achar a
// empresa no webhook sem decifrar todas as chaves.
model ConfiguracaoAsaas {
  id                  String        @id @default(cuid())
  empresaId           String        @unique @map("empresa_id")
  ambiente            AmbienteAsaas
  chaveApiCifrada     String        @map("chave_api_cifrada") @db.Text
  chaveApiUltimos4    String        @map("chave_api_ultimos4")
  tokenWebhookCifrado String        @map("token_webhook_cifrado") @db.Text
  tokenWebhookHash    String        @unique @map("token_webhook_hash")
  criadoEm            DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa             Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("configuracoes_asaas")
}

// Espelho local de uma cobrança do Asaas. O id do pagamento é único dentro
// da empresa e fica vazio só enquanto o status é CRIANDO (a linha nasce
// antes da chamada ao Asaas). A trava de uma emissão por cliente está no
// índice parcial faturas_criando_por_cliente, só no SQL da migration.
// Cobrança de assinatura entra pelo webhook ou pela importação
// e aponta para o vínculo que guarda o asaas_subscription_id.
model Fatura {
  id                String    @id @default(cuid())
  empresaId         String    @map("empresa_id")
  clienteId         String    @map("cliente_id")
  clienteServicoId  String?   @map("cliente_servico_id")
  asaasPaymentId    String?   @map("asaas_payment_id")
  chaveIdempotencia String?   @map("chave_idempotencia")
  valor             Decimal   @db.Decimal(12, 2)
  vencimento        DateTime  @map("vencimento") @db.Date
  status            String
  formaCobranca     String    @map("forma_cobranca")
  boletoUrl         String?   @map("boleto_url") @db.Text
  linhaDigitavel    String?   @map("linha_digitavel") @db.Text
  pixCopiaCola      String?   @map("pix_copia_cola") @db.Text
  faturaUrl         String?   @map("fatura_url") @db.Text
  descricao         String?   @db.Text
  erroEmissao       String?   @map("erro_emissao") @db.Text
  excluida          Boolean   @default(false)
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa          Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteServico   ClienteServico? @relation(fields: [clienteServicoId], references: [id], onDelete: SetNull)
  lembretes        LembreteRegua[]

  @@unique([empresaId, asaasPaymentId])
  @@unique([empresaId, chaveIdempotencia])
  @@index([empresaId, excluida, status])
  @@index([clienteId])
  @@index([clienteServicoId])
  @@map("faturas")
}

// Id do evento do Asaas, único por empresa, para o webhook ser idempotente.
model EventoAsaas {
  id           String   @id @default(cuid())
  empresaId    String   @map("empresa_id")
  asaasEventId String   @map("asaas_event_id")
  tipo         String
  recebidoEm   DateTime @default(now()) @map("recebido_em") @db.Timestamptz(3)
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, asaasEventId])
  @@index([empresaId])
  @@map("eventos_asaas")
}

// Liga e desliga a régua da empresa e guarda o remetente. A chave da Resend
// usa a mesma cifra da ASAAS_ENCRYPTION_KEY. modoTeste começa ligado: o envio
// vai para o dono, não para o cliente, até o dono desligar.
model ConfiguracaoRegua {
  id                 String   @id @default(cuid())
  empresaId          String   @unique @map("empresa_id")
  ativa              Boolean  @default(false)
  modoTeste          Boolean  @default(true) @map("modo_teste")
  remetenteNome      String?  @map("remetente_nome")
  remetenteEmail     String?  @map("remetente_email")
  replyTo            String?  @map("reply_to")
  chaveResendCifrada String?  @map("chave_resend_cifrada") @db.Text
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("configuracoes_regua")
}

// Várias réguas por empresa. Uma delas é a padrão (índice único parcial na
// migration). Horário e fim de semana são desta régua, não da empresa.
model ReguaCobranca {
  id                 String   @id @default(cuid())
  empresaId          String   @map("empresa_id")
  nome               String
  padrao             Boolean  @default(false)
  horaInicio         Int      @default(8) @map("hora_inicio")
  horaFim            Int      @default(18) @map("hora_fim")
  enviarFimDeSemana  Boolean  @default(false) @map("enviar_fim_de_semana")
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  passos             PassoRegua[]
  clientes           Cliente[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("reguas_cobranca")
}

model PassoRegua {
  id         String   @id @default(cuid())
  reguaId    String   @map("regua_id")
  empresaId  String   @map("empresa_id")
  ordem      Int
  naEmissao  Boolean  @default(false) @map("na_emissao")
  dias       Int?
  canal      String   @default("EMAIL")
  assunto    String
  corpo      String   @db.Text
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  regua      ReguaCobranca @relation(fields: [reguaId], references: [id], onDelete: Cascade)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  lembretes  LembreteRegua[]

  @@index([reguaId, ordem])
  @@index([empresaId])
  @@map("passos_regua")
}

// Histórico por cobrança. O índice único parcial de envio automático bem-sucedido
// (fatura + passo) fica na migration, para uma falha ou um envio manual poder repetir.
model LembreteRegua {
  id          String   @id @default(cuid())
  empresaId   String   @map("empresa_id")
  faturaId    String   @map("fatura_id")
  passoId     String?  @map("passo_id")
  clienteId   String   @map("cliente_id")
  canal       String
  status      String
  motivo      String?
  destino     String?
  automatico  Boolean
  modoTeste   Boolean  @map("modo_teste")
  rotulo      String
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fatura      Fatura   @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  passo       PassoRegua? @relation(fields: [passoId], references: [id], onDelete: SetNull)
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([faturaId, criadoEm])
  @@index([empresaId])
  @@map("lembretes_regua")
}
